{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "strategy": "prefer_ipv4",
    "servers": [
      {
        "tag": "dns-ali",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "DIRECT"
      },
      {
        "tag": "dns-google",
        "type": "https",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-openai"],
        "server": "dns-google"
      },
      {
        "rule_set": ["geosite-cn"],
        "server": "dns-ali"
      }
    ],
    "final": "dns-ali"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "sniff": true,
      "sniff_override_destination": true
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "type": "direct"
    },
    {
      "tag": "REJECT",
      "type": "block"
    },
    {
      "tag": "🚀 节点选择",
      "type": "selector",
      "outbounds": ["♻️ 自动选择", "DIRECT"],
      "default": "♻️ 自动选择"
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {{ .Nodes }}
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "🚀 节点选择",
    "rule_set": [
      {
        "tag": "geosite-openai",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs",
        "download_detour": "DIRECT"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "DIRECT"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "DIRECT"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-openai"],
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": ["geosite-cn", "geoip-cn"],
        "outbound": "DIRECT"
      }
    ]
  }
}
