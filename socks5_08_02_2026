    printf "   ${COLOR_INF}${BOLD}➤ 认证账号      :${RESET}  ${COLOR_TXT}${BOLD}%s${RESET}\n" "${SOCKS_USER}"
    printf "   ${COLOR_INF}${BOLD}➤ 认证密码      :${RESET}  ${COLOR_TXT}${BOLD}%s${RESET}\n" "${SOCKS_PASS}"
    echo ""
