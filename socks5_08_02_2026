# =================================================================================
# Core Management Function Library
# =================================================================================
restart_service() {
    print_banner
    print_note "正在重载配置并平滑重启..."
    load_config
    if command -v systemctl >/dev/null 2>&1 && systemctl list-units >/dev/null 2>&1; then 
        systemctl restart socks5 >/dev/null 2>&1
    elif command -v rc-service >/dev/null 2>&1; then 
        rc-service socks5 restart >/dev/null 2>&1
    else 
        pkill -9 -f "gost" >/dev/null 2>&1; nohup /usr/local/bin/gost -L socks5://${SOCKS_USER}:${SOCKS_PASS}@:${SOCKS_PORT} >/dev/null 2>&1 &
    fi
    print_ok "引擎状态已刷新，配置更改已生效。"; sleep 1.5
}

stop_service() {
    print_banner
    print_note "正在终止活动的代理服务进程..."
    command -v systemctl >/dev/null 2>&1 && systemctl list-units >/dev/null 2>&1 && systemctl stop socks5 >/dev/null 2>&1
    command -v rc-service >/dev/null 2>&1 && rc-service socks5 stop >/dev/null 2>&1
    pkill -9 -f "gost" >/dev/null 2>&1 || true
    print_warn "代理通信通道已安全关闭。"; sleep 1.5
}

toggle_autostart() {
    print_banner
    print_note "正在切换系统开机自启服务状态..."
    if command -v systemctl >/dev/null 2>&1 && systemctl list-units >/dev/null 2>&1; then
        if systemctl is-enabled --quiet socks5 2>/dev/null; then
            systemctl disable socks5 >/dev/null 2>&1; print_warn "已禁用开机自动启动。"
        else
            systemctl enable socks5 >/dev/null 2>&1; print_ok "已启用开机自动启动。"
        fi
    elif command -v rc-update >/dev/null 2>&1; then
        if rc-update show default 2>/dev/null | grep -q "socks5"; then
            rc-update del socks5 default >/dev/null 2>&1; print_warn "已禁用开机自动启动。"
        else
            rc-update add socks5 default >/dev/null 2>&1; print_ok "已启用开机自动启动。"
        fi
    else 
        print_warn "当前环境不支持自启管理。"; 
    fi
    sleep 1.5
}

view_logs() {
    print_banner
    draw_line "$COLOR_MAIN"
    print_center "系统运行日志与诊断信息" "$COLOR_SEC"
    draw_line "$COLOR_MAIN"
    echo ""
    if command -v journalctl >/dev/null 2>&1 && systemctl list-units >/dev/null 2>&1; then
        journalctl -u socks5 -n 20 --no-pager 2>/dev/null || echo "暂无可用的 systemd 日志记录。"
    else
        echo "系统正通过后台 nohup 或 OpenRC 运行。活跃进程："
        ps aux | grep gost | grep -v grep || echo "未检测到活跃的 gost 进程。"
    fi
    echo ""
    draw_dash "$COLOR_SEC"
    printf "\n   ${COLOR_SEC}👉 按任意键返回主控制面板...${RESET}"
    read -n 1 -s -r < /dev/tty 2>/dev/null || read -n 1 -s -r
}

test_port() {
    print_banner
    load_config
    print_note "正在执行端口连通性与代理转发诊断..."
    echo ""
    if command -v nc >/dev/null 2>&1; then
        nc -zv 127.0.0.1 "$SOCKS_PORT" 2>&1 && print_ok "本地环回检查通过。" || print_err "本地环回检查失败。"
    elif command -v curl >/dev/null 2>&1; then
        curl -s --socks5 "${SOCKS_USER}:${SOCKS_PASS}@127.0.0.1:${SOCKS_PORT}" https://api.ipify.org -m 3 && print_ok "Socks5 隧道代理测试成功。" || print_err "代理隧道测试失败。"
    else
        print_warn "未找到诊断工具 (nc/curl)，已跳过深度测试。"
    fi
    echo ""
    draw_dash "$COLOR_SEC"
    printf "\n   ${COLOR_SEC}👉 按任意键返回主控制面板...${RESET}"
    read -n 1 -s -r < /dev/tty 2>/dev/null || read -n 1 -s -r
}

update_script() {
    print_banner
    print_note "正在从远程源获取最新管理脚本..."
    curl -fsSL "https://gist.githubusercontent.com/Puthsent/36817edc52867fd74559fde96339af99/raw/S5" -o /tmp/s5_update.sh 2>/dev/null
    if [ -s /tmp/s5_update.sh ]; then
        print_ok "更新脚本下载成功，正在更新面板..."
        cp -f /tmp/s5_update.sh "$SHORTCUT_BIN" 2>/dev/null
        chmod +x "$SHORTCUT_BIN" 2>/dev/null
        bash /tmp/s5_update.sh
        exit 0
    else
        print_err "更新失败：无法下载远程脚本，请验证网络访问。"
        sleep 1.5
    fi
}

uninstall_socks5() {
    clear; print_banner
    echo -e "   ${COLOR_ERR}${BOLD}⚠ 危险警告：此操作将彻底删除 SOCKS5 节点及相关配置！${RESET}\n"
    printf "   ${COLOR_WAR}${BOLD}确定要继续执行卸载吗？(y/N): ${RESET}"
    read -r CONFIRM < /dev/tty 2>/dev/null || read -r CONFIRM
    if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
        print_banner
        print_note "正在执行清理卸载程序..."
        load_config; stop_service
        if command -v iptables >/dev/null 2>&1 && [ -n "$SOCKS_PORT" ]; then
            iptables -D INPUT -p tcp --dport "$SOCKS_PORT" -j ACCEPT 2>/dev/null
            iptables -D INPUT -p udp --dport "$SOCKS_PORT" -j ACCEPT 2>/dev/null
        fi
        command -v systemctl >/dev/null 2>&1 && systemctl list-units >/dev/null 2>&1 && { systemctl disable socks5 >/dev/null 2>&1; rm -f /etc/systemd/system/socks5.service; systemctl daemon-reload; }
        command -v rc-service >/dev/null 2>&1 && { rc-update del socks5 default >/dev/null 2>&1; rm -f /etc/init.d/socks5; }
        rm -f /usr/local/bin/gost "$SHORTCUT_BIN" "$CONFIG_FILE"
        print_ok "系统已成功清理并恢复至初始状态。"; exit 0
    else print_info "已取消卸载，返回主菜单。"; sleep 1.2; fi
}

# =================================================================================
# Interactive Control Matrix Main Loop and Execution Entry
# =================================================================================
menu_ui() {
    while true; do
        load_config
        print_banner
        echo -e "  ${COLOR_SEC}${BOLD}┌────────────────────────────────────────────────────────────┐${RESET}"
        echo -e "  ${COLOR_SEC}${BOLD}│${RESET}  ${ICON_NOTE} ${COLOR_TXT}${BOLD}快捷提示:${RESET} 在任意终端输入 ${COLOR_SUC}${BOLD}S5${RESET} 即可打开此控制台         ${COLOR_SEC}${BOLD}│${RESET}"
        echo -e "  ${COLOR_SEC}${BOLD}└────────────────────────────────────────────────────────────┘${RESET}"
        echo ""
        echo -e "   📡 服务运行状态  : $(get_service_status)"
        echo -e "   🚀 开机自启策略  : $(get_autostart_status)"
        draw_dash "$COLOR_SEC"
        echo -e "  ${COLOR_MAIN}${BOLD} [1]${RESET} ${COLOR_TXT} 查看连接凭证与链接信息${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [2]${RESET} ${COLOR_TXT} 启动 / 平滑重启代理服务${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [3]${RESET} ${COLOR_TXT} 停止 / 安全终止代理服务${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [4]${RESET} ${COLOR_TXT} 切换系统开机自启策略${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [5]${RESET} ${COLOR_TXT} 重新配置端口 / 凭证并重新部署${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [6]${RESET} ${COLOR_TXT} 查看系统运行日志与诊断${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [7]${RESET} ${COLOR_TXT} 执行本地端口与隧道诊断测试${RESET}"
        echo -e "  ${COLOR_MAIN}${BOLD} [8]${RESET} ${COLOR_TXT} 检查脚本更新与热刷新${RESET}"
        echo -e "  ${COLOR_ERR}${BOLD} [9]${RESET} ${COLOR_ERR} 完全卸载并清理系统环境${RESET}"
        draw_dash "$COLOR_SEC"
        echo -e "  ${COLOR_WAR}${BOLD} [0]${RESET} ${COLOR_TXT} 退出控制面板并返回 Shell${RESET}"
        draw_line "$COLOR_MAIN"
        echo ""
        printf "  ${COLOR_INF}${BOLD}⚡ 请输入菜单选项代码 [0-9]: ${RESET}"
        read -r CHOICE < /dev/tty 2>/dev/null || read -r CHOICE
        case "$CHOICE" in
            1) show_credentials ;;
            2) restart_service ;;
            3) stop_service ;;
            4) toggle_autostart ;;
            5) collect_parameters; download_core; setup_daemon; configure_firewall; restart_service; show_credentials ;;
            6) view_logs ;;
            7) test_port ;;
            8) update_script ;;
            9) uninstall_socks5 ;;
            0) echo -e "\n   ${COLOR_SUC}${BOLD}✨ 会话已关闭。随时输入 ${COLOR_SUC}${BOLD}S5${RESET}${COLOR_SUC}${BOLD} 即可重新打开管理控制台！${RESET}\n"; exit 0 ;;
            *) print_warn "无效的选项代码：请输入 0 到 9 之间的数字。"; sleep 1.2 ;;
        esac
    done
}

main() {
    install_shortcut
    check_environment_and_deps
    if [ -f "$CONFIG_FILE" ] && [ -f "/usr/local/bin/gost" ]; then
        menu_ui
    else
        collect_parameters
        download_core
        setup_daemon
        configure_firewall
        show_credentials
        menu_ui
    fi
}

main "$@"
