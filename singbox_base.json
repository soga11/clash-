{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": false
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "local",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:0470:f9da:fdfa::1/64"
      }
    ],
    "rules": [
      {
        "clash_mode": "global",
        "server": "remote"
      },
      {
        "clash_mode": "direct",
        "server": "local"
      },
      {
        "rule_set": "geosite-cn",
        "server": "local"
      },
      {
        "query_type": ["A", "AAAA"],
        "rewrite_ttl": 1,
        "server": "fakeip"
      }
    ],
    "strategy": "prefer_ipv4",
    "final": "remote"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": ""
    }
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "listen_port": 1053
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2334
    }
  ],
  "outbounds": [
    {
      "tag": "🚀 节点选择",
      "type": "selector",
      "outbounds": ["🇭🇰 香港负载", "👋 手动选择", "♻️ 自动选择", "🇨🇳 台湾负载", "DIRECT"]
    },
    {
      "tag": "👋 手动选择",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "outbounds": [],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "📹 油管视频",
      "type": "selector",
      "outbounds": ["🛡️ 去广告", "👋 手动选择", "♻️ 自动选择", "🇨🇳 台湾负载", "🇭🇰 香港负载", "🚀 节点选择", "DIRECT"]
    },
    {
      "tag": "💬 ChatGPT",
      "type": "selector",
      "outbounds": ["🇨🇳 台湾负载", "👋 手动选择", "♻️ 自动选择", "🇭🇰 香港负载", "🚀 节点选择", "DIRECT"]
    },
    {
      "tag": "📲 电报消息",
      "type": "selector",
      "outbounds": ["🇭🇰 香港负载", "🚀 节点选择"]
    },
    {
      "tag": "🇭🇰 香港负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "电视",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🇨🇳 台湾负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "台湾",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🛡️ 去广告",
      "type": "urltest",
      "outbounds": [],
      "filter": "去广告",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🐟 漏网之鱼",
      "type": "selector",
      "outbounds": ["🚀 节点选择", "DIRECT"]
    },
    {
      "tag": "DIRECT",
      "type": "direct"
    },
    {
      "tag": "REJECT",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "local"
    },
    "final": "🐟 漏网之鱼",
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-openai",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/openai.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-anthropic",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/anthropic.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-google-gemini",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google-gemini.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "clash_mode": "direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "global",
        "outbound": "🚀 节点选择"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "outbound": "REJECT"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "📹 油管视频"
      },
      {
        "rule_set": ["geosite-openai", "geosite-anthropic", "geosite-google-gemini"],
        "outbound": "💬 ChatGPT"
      },
      {
        "domain_suffix": [
          ".deepseek.com",
          ".moonshot.cn",
          ".kimi.moonshot.cn",
          ".perplexity.ai",
          ".copilot.microsoft.com",
          ".zhipuai.cn",
          ".qwen.ai"
        ],
        "outbound": "💬 ChatGPT"
      },
      {
        "rule_set": "geosite-telegram",
        "outbound": "📲 电报消息"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "DIRECT"
      }
    ]
  }
}
