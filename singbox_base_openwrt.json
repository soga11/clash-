{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "Local-DNS",
        "type": "tls",
        "server": "223.5.5.5",
        "server_port": 853
      },
      {
        "tag": "Remote-DNS",
        "type": "tls",
        "server": "8.8.8.8",
        "server_port": 853,
        "detour": "🚀 节点选择"
      },
      {
        "tag": "fake-ip-dns-server",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "Remote-DNS"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fake-ip-dns-server",
        "rewrite_ttl": 1
      }
    ],
    "strategy": "prefer_ipv4",
    "final": "Remote-DNS",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 6053
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "::",
      "listen_port": 6054
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 6055
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": false,
      "strict_route": false,
      "dns_mode": "disabled"
    }
  ],
  "outbounds": [
    {
      "tag": "🚀 节点选择",
      "type": "selector",
      "outbounds": [
        "♻️ 自动选择",
        "👋 手动选择",
        "🇭🇰 香港负载",
        "🇨🇳 台湾负载",
        "🛡️ 去广告",
        "DIRECT"
      ]
    },
    {
      "tag": "👋 手动选择",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "outbounds": [],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "📹 油管视频",
      "type": "selector",
      "outbounds": [
        "🛡️ 去广告",
        "👋 手动选择",
        "♻️ 自动选择",
        "🇨🇳 台湾负载",
        "🇭🇰 香港负载",
        "🚀 节点选择",
        "DIRECT"
      ]
    },
    {
      "tag": "💬 ChatGPT",
      "type": "selector",
      "outbounds": [
        "🇨🇳 台湾负载",
        "👋 手动选择",
        "♻️ 自动选择",
        "🇭🇰 香港负载",
        "🚀 节点选择",
        "DIRECT"
      ]
    },
    {
      "tag": "📲 电报消息",
      "type": "selector",
      "outbounds": [
        "🇭🇰 香港负载",
        "🚀 节点选择"
      ]
    },
    {
      "tag": "🇭🇰 香港负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "电视",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🇨🇳 台湾负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "台湾",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🛡️ 去广告",
      "type": "urltest",
      "outbounds": [],
      "filter": "去广告",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 30
    },
    {
      "tag": "🐟 漏网之鱼",
      "type": "selector",
      "outbounds": [
        "🚀 节点选择",
        "DIRECT"
      ]
    },
    {
      "tag": "DIRECT",
      "type": "direct"
    },
    {
      "tag": "REJECT",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "Local-DNS"
    },
    "final": "🐟 漏网之鱼",
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-openai",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/openai.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-anthropic",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/anthropic.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-google-gemini",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google-gemini.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "update_interval": "24h",
        "http_client": {
          "detour": "🚀 节点选择"
        }
      }
    ],
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "dns-in",
          "redirect-in",
          "tproxy-in",
          "tun-in"
        ]
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "🚀 节点选择"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": "geosite-youtube",
        "action": "route",
        "outbound": "📹 油管视频"
      },
      {
        "rule_set": [
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini"
        ],
        "action": "route",
        "outbound": "💬 ChatGPT"
      },
      {
        "domain_suffix": [
          ".deepseek.com",
          ".moonshot.cn",
          ".kimi.moonshot.cn",
          ".perplexity.ai",
          ".copilot.microsoft.com",
          ".zhipuai.cn",
          ".qwen.ai"
        ],
        "action": "route",
        "outbound": "💬 ChatGPT"
      },
      {
        "rule_set": "geosite-telegram",
        "action": "route",
        "outbound": "📲 电报消息"
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geoip-cn",
        "action": "route",
        "outbound": "DIRECT"
      }
    ]
  }
}
