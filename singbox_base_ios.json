    {
      "tag": "🇭🇰 香港负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "电视",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "🇨🇳 台湾负载",
      "type": "urltest",
      "outbounds": [],
      "filter": "台湾",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "jj",
      "type": "urltest",
      "outbounds": [],
      "filter": "jj",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "🛡️ 去广告",
      "type": "urltest",
      "outbounds": [],
      "filter": "去广告",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "15m",
      "tolerance": 100
    },
    {
      "tag": "🌐 全球直连",
      "type": "selector",
      "outbounds": [
        "DIRECT",
        "🚀 节点选择"
      ]
