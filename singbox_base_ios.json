        "👋 手动选择"
      ]
    },
    {
      "tag": "📱 社交媒体",
      "type": "selector",
      "outbounds": [
        "jj",
        "🇨🇳 台湾负载",
        "🇭🇰 香港负载",
        "🚀 节点选择",
        "👋 手动选择"
      ]
    },
    {
      "tag": "📲 电报消息",
      "type": "selector",
      "outbounds": [
        "🇭🇰 香港负载",
        "🛡️ 去广告",
